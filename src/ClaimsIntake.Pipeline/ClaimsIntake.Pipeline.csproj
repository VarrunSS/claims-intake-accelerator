<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ClaimsIntake.Pipeline</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The NuGet id is PdfPig; the namespaces are still UglyToad.PdfPig. The old id UglyToad.PdfPig has no stable release. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.Search.Documents" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaimsIntake.Domain\ClaimsIntake.Domain.csproj" />
    <ProjectReference Include="..\ClaimsIntake.Security\ClaimsIntake.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The policy wordings are the corpus for the local search. They flow to every app that references this project. -->
    <Content Include="..\..\samples\policy-wordings\TM-PW-*.md" Link="policy-wordings\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The versioned prompts (prompts/<kind>/v<n>.md) are embedded so the Function and the evaluation read the same text. -->
    <EmbeddedResource Include="..\..\prompts\*\v*.md" LogicalName="prompts/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaimsIntake.Pipeline.Tests" />
  </ItemGroup>

</Project>
