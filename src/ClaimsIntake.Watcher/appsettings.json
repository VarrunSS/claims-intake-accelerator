{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning",
      "Polly": "Warning"
    }
  },
  "Telemetry": {
    "Exporter": "console"
  },
  "LocalInbox": {
    "Path": "../../local-inbox",
    "PollInterval": "00:00:01"
  },
  "Intake": {
    "TextExtractor": "Local",
    "ClaimExtractor": "Heuristic",
    "Sink": "Http",
    "Legacy": { "BaseUrl": "http://localhost:5200" },
    "Api": { "BaseUrl": "http://localhost:5100" }
  }
}
