<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClaimsIntake.Evals</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Identity.Web (via ClaimsIntake.Security.AspNetCore) brings these in at 10.0.10, which has advisories (NU1903). Pin the patched release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <!-- Chat clients for the model kinds in evals/models.json. Azure.AI.Inference is beta only and its Extensions.AI adapter is a preview: evaluation tooling only, never the Function. -->
    <PackageReference Include="Anthropic.Foundry" Version="1.0.0" />
    <PackageReference Include="Azure.AI.Inference" Version="1.0.0-beta.5" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.AI.AzureAIInference" Version="10.0.0-preview.1.25559.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaimsIntake.Pipeline\ClaimsIntake.Pipeline.csproj" />
    <!-- The seeded policies are the single source of truth for the policy lookup in the evaluation. -->
    <ProjectReference Include="..\..\src\ClaimsIntake.Legacy\ClaimsIntake.Legacy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaimsIntake.Evals.Tests" />
  </ItemGroup>

</Project>
