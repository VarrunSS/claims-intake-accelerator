    "/claims/{id}/approve": {
      "post": {
        "tags": [
          "Claims"
        ],
        "summary": "Approves a claim and writes it to the legacy claims system. A claim routed to senior review needs the SeniorHandler role.",
        "description": "Requires one of the app roles: ClaimsHandler, SeniorHandler.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/ApproveRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
