{
  "openapi": "3.1.1",
  "info": {
    "title": "Claims Intake review API",
    "description": "The review queue for proposed claims: list, read, approve and reject. Every route needs a Microsoft Entra ID access token (bearer). People need the ClaimsHandler or SeniorHandler app role; a claim routed to senior review can only be approved by a SeniorHandler. /claims/history and /intake/claims take app-only tokens with their own roles. The health probes are anonymous. Errors are RFC 7807 problem details.",
    "version": "v1"
  },
  "paths": {
    "/me": {
      "get": {
        "tags": [
          "Claims"
        ],
        "summary": "Who the token says the caller is, and what roles it carries.",
        "description": "Requires one of the app roles: ClaimsHandler, SeniorHandler.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "x-required-roles": [
          "ClaimsHandler",
          "SeniorHandler"
        ]
      }
    },
    "/claims/history": {
      "get": {
        "tags": [
          "Claims"
        ],
        "summary": "Claims on a policy that could still be duplicates. App-only: the intake pipeline\u0027s duplicate check.",
