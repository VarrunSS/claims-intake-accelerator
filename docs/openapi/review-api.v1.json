  "components": {
    "schemas": {
      "ApproveRequest": {
        "type": "object",
        "properties": {
          "reviewer": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuditEntryDto": {
        "required": [
          "tool",
          "arguments",
          "resultSummary",
          "durationMs",
          "timestamp",
          "succeeded"
        ],
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resultSummary": {
            "type": "string"
          },
          "durationMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "succeeded": {
            "type": "boolean"
          }
        }
      },
      "ClaimAssessment": {
        "required": [
          "assessor",
          "findings",
          "route",
          "routeReason",
          "notes"
        ],
        "type": "object",
        "properties": {
          "assessor": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoverageFinding"
            }
          },
          "route": {
            "$ref": "#/components/schemas/ReviewRoute"
          },
          "routeReason": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ClaimDetail": {
        "required": [
          "id",
          "sourceDocumentId",
          "status",
          "receivedAt",
          "fields",
          "issues",
          "sourcePages",
          "decidedBy",
          "decidedByName",
          "decidedAt",
          "rejectionReason",
          "legacyReference"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceDocumentId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldDto"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueDto"
            }
          },
          "sourcePages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decidedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "decidedByName": {
            "type": [
              "null",
              "string"
            ]
          },
          "decidedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "rejectionReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "legacyReference": {
            "type": [
              "null",
              "string"
            ]
          },
          "assessment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ClaimAssessment"
              }
            ]
          }
        }
      },
      "ClaimHistoryItem": {
        "required": [
          "id",
          "policyNumber",
          "lossDate",
          "amountGbp",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "policyNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "lossDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "amountGbp": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          }
        }
      },
      "ClaimStatus": {
        "enum": [
          "NeedsReview",
          "Approved",
          "Rejected",
          "Submitted"
        ]
      },
      "ClaimSummary": {
        "required": [
          "id",
          "sourceDocumentId",
          "policyNumber",
          "claimantName",
          "status",
          "receivedAt",
          "errorCount",
          "warningCount",
          "minConfidence",
          "legacyReference"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceDocumentId": {
            "type": "string"
          },
          "policyNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "claimantName": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "errorCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "warningCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "minConfidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "legacyReference": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ClauseCitation": {
        "required": [
          "wordingId",
          "clauseRef",
          "heading",
          "text"
        ],
        "type": "object",
        "properties": {
          "wordingId": {
            "type": "string"
          },
          "clauseRef": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "CoverageFinding": {
        "required": [
          "kind",
          "summary",
          "citations"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/FindingKind"
          },
          "summary": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClauseCitation"
            }
          },
          "relatedClaimRef": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FieldDto": {
        "required": [
          "name",
          "value",
          "confidence",
          "source"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "null",
              "string"
            ]
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
