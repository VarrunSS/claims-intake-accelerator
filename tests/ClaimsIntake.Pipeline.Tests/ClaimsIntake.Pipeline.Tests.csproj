<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaimsIntake.Pipeline\ClaimsIntake.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\ClaimsIntake.Functions\ClaimsIntake.Functions.csproj" />
    <ProjectReference Include="..\..\src\ClaimsIntake.Ingestion\ClaimsIntake.Ingestion.csproj" />
    <ProjectReference Include="..\..\src\ClaimsIntake.Legacy\ClaimsIntake.Legacy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample claim documents are used as test inputs. -->
    <Content Include="..\..\samples\*.pdf;..\..\samples\*.txt;..\..\samples\*.eml" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- A scan with no text, a password-protected PDF and a truncated PDF, written by evals/generate_dataset.py. -->
    <Content Include="fixtures\*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
